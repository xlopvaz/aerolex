---
/**
 * Base layout for every page: <head> (SEO, hreflang, theme bootstrap), header, main, footer.
 */
import '@fontsource-variable/inter';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';
import '../styles/tokens.css';
import '../styles/base.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileNav from '../components/MobileNav.astro';
import RewardToast from '../components/gamification/RewardToast.astro';
import { LOCALES, LOCALE_META } from '../i18n/config.js';
import { alternates, href, t, withBase } from '../i18n/index.js';
import { STORAGE_KEY } from '../lib/core/schema.js';

interface Props {
  lang: string;
  /** Registered route key; also marks the active item in the navigation. */
  routeKey: any;
  title: string;
  description?: string;
  /** Equivalent URL in each language. Defaults to the route's alternates; pass it for dynamic pages. */
  alt?: Record<string, string>;
}
const { lang, routeKey, title, description = t(lang, 'meta.defaultDescription'), alt: altProp } = Astro.props;

const site = Astro.site ?? new URL('https://xlopvaz.github.io');
const abs = (p: string) => new URL(p, site).href;
const alt = altProp ?? alternates(routeKey);
const canonical = abs(alt[lang] ?? href(routeKey, lang));
---
<!doctype html>
<html lang={LOCALE_META[lang].htmlLang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={abs(alt[l])} />)}
    <link rel="alternate" hreflang="x-default" href={abs(withBase(''))} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AeroLex" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={LOCALE_META[lang].ogLocale} />
    <meta name="theme-color" content="#0A1628" />

    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />

    <!-- Apply the saved theme before first paint (no flash). -->
    <script is:inline define:vars={{ key: STORAGE_KEY }}>
      (function () {
        var pref = 'system';
        try {
          var s = JSON.parse(localStorage.getItem(key) || 'null');
          if (s && s.prefs && s.prefs.theme) pref = s.prefs.theme;
        } catch (e) {}
        var dark = pref === 'dark' || (pref === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        var theme = dark ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'a11y.skipToContent')}</a>
    <Header lang={lang} routeKey={routeKey} alt={alt} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <MobileNav lang={lang} routeKey={routeKey} />
    <RewardToast lang={lang} />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: -100px;
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--primary);
    color: var(--on-primary);
    font-weight: 600;
  }
  .skip-link:focus { top: var(--space-3); }
  main:focus { outline: none; }
</style>
