---
/**
 * Root (/aerolex/): sends the visitor to their language.
 * Order: saved preference -> browser languages -> English. Without JS, shows both links.
 */
import '../styles/tokens.css';
import '../styles/base.css';
import Logo from '../components/Logo.astro';
import { href, t, withBase } from '../i18n/index.js';
import { STORAGE_KEY } from '../lib/core/schema.js';

const targets = { es: href('home', 'es'), en: href('home', 'en') };
const site = Astro.site ?? new URL('https://xlopvaz.github.io');
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AeroLex · Learn the language of the sky</title>
    <meta name="description" content={t('en', 'meta.defaultDescription')} />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" hreflang="es" href={new URL(targets.es, site).href} />
    <link rel="alternate" hreflang="en" href={new URL(targets.en, site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(withBase(''), site).href} />
    <script is:inline define:vars={{ key: STORAGE_KEY, targets }}>
      (function () {
        var lang = null;
        try {
          var s = JSON.parse(localStorage.getItem(key) || 'null');
          if (s && s.prefs && (s.prefs.lang === 'es' || s.prefs.lang === 'en')) lang = s.prefs.lang;
        } catch (e) {}
        if (!lang) {
          var langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || 'en'];
          for (var i = 0; i < langs.length; i++) {
            var code = String(langs[i]).toLowerCase().slice(0, 2);
            if (code === 'es' || code === 'en') { lang = code; break; }
          }
        }
        location.replace(targets[lang || 'en']);
      })();
    </script>
  </head>
  <body>
    <main class="root">
      <Logo size={48} />
      <p class="root__msg">{t('es', 'root.redirecting')} · {t('en', 'root.redirecting')}</p>
      <p class="root__links">
        <a href={targets.es} hreflang="es" lang="es">Español</a>
        <a href={targets.en} hreflang="en" lang="en">English</a>
      </p>
    </main>
  </body>
</html>

<style>
  .root { min-height: 100vh; display: grid; place-content: center; justify-items: center; gap: var(--space-4); text-align: center; padding: var(--space-6); }
  .root__msg { color: var(--text-muted); margin: 0; }
  .root__links { display: flex; gap: var(--space-5); font-weight: 600; }
</style>
