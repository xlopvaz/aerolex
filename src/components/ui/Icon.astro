---
/**
 * Icon: inlines a Lucide icon (ISC licence) at build time. No JS, no network request.
 *   <Icon name="plane" />  <Icon name="sun" size={18} label="Light theme" />
 * Decorative by default (aria-hidden); pass `label` when the icon carries meaning on its own.
 */
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  name: string;
  size?: number;
  label?: string;
  class?: string;
  strokeWidth?: number;
}
const { name, size = 20, label, class: className = '', strokeWidth = 1.75 } = Astro.props;

const file = path.join(process.cwd(), 'node_modules', 'lucide-static', 'icons', `${name}.svg`);
if (!fs.existsSync(file)) throw new Error(`Icon "${name}" not found in lucide-static`);

const inner = fs
  .readFileSync(file, 'utf8')
  .replace(/<!--[\s\S]*?-->/g, '')
  .replace(/^[\s\S]*?<svg[^>]*>/, '')
  .replace(/<\/svg>\s*$/, '')
  .trim();
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['icon', className]}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={inner}
/>
<style>
  .icon { flex: none; display: inline-block; vertical-align: middle; }
</style>
