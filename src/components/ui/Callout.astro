---
/**
 * Highlighted note inside lessons and entries.
 * Types: info | tip | caution | warning | regional-diff (EASA/FAA) | official-procedure
 */
import Icon from './Icon.astro';

interface Props {
  type?: 'info' | 'tip' | 'caution' | 'warning' | 'regional-diff' | 'official-procedure';
  label: string;
}
const { type = 'info', label } = Astro.props;
const icons = {
  info: 'info',
  tip: 'lightbulb',
  caution: 'triangle-alert',
  warning: 'octagon-alert',
  'regional-diff': 'globe',
  'official-procedure': 'file-check',
};
---
<aside class:list={['callout', `callout--${type}`]} role="note">
  <Icon name={icons[type]} size={20} class="callout__icon" />
  <div>
    <p class="callout__label">{label}</p>
    <div class="callout__body"><slot /></div>
  </div>
</aside>

<style>
  .callout {
    --c: var(--primary);
    --bg: var(--primary-soft);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border: 1px solid color-mix(in srgb, var(--c) 30%, transparent);
    border-left: 4px solid var(--c);
    border-radius: var(--radius-md);
    background: var(--bg);
  }
  .callout :global(.callout__icon) { color: var(--c); margin-top: 2px; }
  .callout__label {
    margin: 0 0 var(--space-1);
    color: var(--c);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .callout__body :global(> :last-child) { margin-bottom: 0; }
  .callout--tip { --c: var(--green); --bg: var(--green-soft); }
  .callout--caution { --c: var(--amber); --bg: var(--amber-soft); }
  .callout--warning { --c: var(--red); --bg: var(--red-soft); }
  .callout--regional-diff { --c: var(--magenta); --bg: var(--magenta-soft); }
  .callout--official-procedure { --c: var(--cyan); --bg: var(--cyan-soft); }
</style>
