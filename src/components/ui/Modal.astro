---
/**
 * Dialog built on native <dialog> (focus trap, Escape to close, backdrop).
 * Open it with any element carrying data-open-modal="<id>".
 * Buttons inside with data-close-modal close it; their value is returned in dialog.returnValue.
 */
import Icon from './Icon.astro';
interface Props { id: string; title: string; closeLabel: string }
const { id, title, closeLabel } = Astro.props;
---
<dialog class="modal" id={id} aria-labelledby={`${id}-title`}>
  <form method="dialog" class="modal__inner">
    <header class="modal__header">
      <h2 id={`${id}-title`} class="modal__title">{title}</h2>
      <button class="modal__close" value="cancel" data-close-modal aria-label={closeLabel}><Icon name="x" size={20} /></button>
    </header>
    <div class="modal__body"><slot /></div>
    {Astro.slots.has('actions') && <footer class="modal__actions"><slot name="actions" /></footer>}
  </form>
</dialog>

<script>
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const opener = target.closest?.('[data-open-modal]') as HTMLElement | null;
    if (opener) {
      const dlg = document.getElementById(opener.dataset.openModal!) as HTMLDialogElement | null;
      dlg?.showModal();
      return;
    }
    // Click on the backdrop closes the dialog
    if (target instanceof HTMLDialogElement && target.classList.contains('modal')) target.close('cancel');
  });
</script>

<style>
  .modal {
    width: min(520px, calc(100vw - 2rem));
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow-md);
  }
  .modal::backdrop { background: rgba(3, 8, 18, 0.6); backdrop-filter: blur(3px); }
  .modal[open] { animation: modal-in var(--dur) var(--ease); }
  @keyframes modal-in { from { opacity: 0; transform: translateY(8px) scale(0.98); } }
  .modal__inner { padding: var(--space-5) var(--space-6) var(--space-6); }
  .modal__header { display: flex; align-items: start; justify-content: space-between; gap: var(--space-4); }
  .modal__title { font-size: var(--text-xl); margin: 0 0 var(--space-3); }
  .modal__close {
    display: inline-grid; place-items: center;
    width: 36px; height: 36px; flex: none;
    border: 0; border-radius: var(--radius-pill);
    background: transparent; color: var(--text-muted); cursor: pointer;
  }
  .modal__close:hover { background: var(--surface-2); color: var(--text); }
  .modal__body { color: var(--text-muted); }
  .modal__body :global(> :last-child) { margin-bottom: 0; }
  .modal__actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: var(--space-3); margin-top: var(--space-5); }
</style>
