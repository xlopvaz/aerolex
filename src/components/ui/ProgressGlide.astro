---
/** Progress bar styled as an approach: the aircraft descends along the glide path toward the runway. */
import Icon from './Icon.astro';
interface Props { value: number; label: string; showValue?: boolean }
const { value, label, showValue = true } = Astro.props;
const v = Math.max(0, Math.min(100, Math.round(value)));
---
<div class="glide">
  <div class="glide__head">
    <span class="glide__label">{label}</span>
    {showValue && <span class="glide__value mono">{v}%</span>}
  </div>
  <div class="glide__track" role="progressbar" aria-label={label} aria-valuemin="0" aria-valuemax="100" aria-valuenow={v} style={`--v:${v}%`}>
    <div class="glide__fill"></div>
    <span class="glide__plane"><Icon name="plane" size={16} /></span>
    <span class="glide__rwy" aria-hidden="true"></span>
  </div>
</div>

<style>
  .glide__head { display: flex; justify-content: space-between; margin-bottom: var(--space-2); font-size: var(--text-sm); }
  .glide__label { color: var(--text-muted); }
  .glide__value { color: var(--magenta); font-weight: 600; }
  .glide__track {
    position: relative;
    height: 10px;
    border-radius: var(--radius-pill);
    background:
      repeating-linear-gradient(90deg, var(--border) 0 10px, transparent 10px 18px) center / 100% 2px no-repeat,
      var(--surface-2);
    margin-right: 18px;
  }
  .glide__fill {
    position: absolute; inset: 0 auto 0 0;
    width: var(--v);
    border-radius: inherit;
    background: linear-gradient(90deg, color-mix(in srgb, var(--magenta) 40%, transparent), var(--magenta));
    transition: width var(--dur-slow) var(--ease);
  }
  .glide__plane {
    position: absolute; top: 50%; left: var(--v);
    transform: translate(-50%, -50%) rotate(45deg);
    display: inline-flex; padding: 3px;
    border-radius: var(--radius-pill);
    background: var(--surface); color: var(--magenta);
    box-shadow: 0 0 0 2px var(--magenta);
    transition: left var(--dur-slow) var(--ease);
  }
  .glide__rwy {
    position: absolute; top: 50%; right: -18px;
    width: 14px; height: 18px; transform: translateY(-50%);
    border-radius: 2px;
    background: repeating-linear-gradient(90deg, var(--text-muted) 0 2px, transparent 2px 4px);
    opacity: 0.7;
  }
</style>
