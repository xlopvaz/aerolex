---
/**
 * Original hero illustration: night approach to a runway.
 * Details are drawn the way a pilot sees them: green threshold lights, white edge and
 * centreline lights, red runway-end lights, an approach light system with a crossbar,
 * and a PAPI on the left showing two white + two red (on the glide path).
 */
interface Props { alt: string }
const { alt } = Astro.props;

// Runway geometry (near threshold at y=360, far end at y=255)
const near = { l: 196, r: 444, y: 362 };
const far = { l: 306, r: 334, y: 255 };
const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
const edgeLights = Array.from({ length: 13 }, (_, i) => {
  const t = Math.pow(i / 12, 0.75);
  return { y: lerp(near.y, far.y, t), l: lerp(near.l, far.l, t), r: lerp(near.r, far.r, t), s: lerp(2.6, 0.9, t) };
});
const centre = Array.from({ length: 9 }, (_, i) => {
  const t = Math.pow((i + 0.5) / 9, 0.8);
  return { y: lerp(near.y - 6, far.y + 4, t), h: lerp(9, 2, t), w: lerp(2.4, 0.8, t) };
});
const threshold = Array.from({ length: 17 }, (_, i) => lerp(near.l + 4, near.r - 4, i / 16));
const farEnd = Array.from({ length: 6 }, (_, i) => lerp(far.l + 1, far.r - 1, i / 5));
const stars = [
  [42, 38, 1.2], [96, 84, 0.8], [150, 30, 1], [210, 66, 0.7], [268, 22, 1.1], [352, 54, 0.8], [402, 26, 1.3],
  [460, 72, 0.9], [512, 34, 1], [580, 60, 1.2], [612, 110, 0.8], [30, 140, 0.7], [560, 150, 0.9], [120, 170, 0.6],
  [470, 130, 0.7], [330, 120, 0.6], [240, 140, 0.8],
];
const cityLights = [
  [36, 252], [58, 249], [80, 253], [104, 248], [126, 251], [150, 254], [176, 250],
  [470, 252], [492, 248], [516, 253], [540, 249], [566, 252], [590, 248], [612, 253],
];
---
<svg class="hero-art" viewBox="0 0 640 420" role="img" aria-label={alt} preserveAspectRatio="xMidYMid slice">
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#050C1A" />
      <stop offset="0.55" stop-color="#0B1E3D" />
      <stop offset="0.82" stop-color="#1B3563" />
      <stop offset="1" stop-color="#2A3E6B" />
    </linearGradient>
    <linearGradient id="ground" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0A1426" />
      <stop offset="1" stop-color="#03070F" />
    </linearGradient>
    <linearGradient id="rwy" x1="0" y1="1" x2="0" y2="0">
      <stop offset="0" stop-color="#1A2436" />
      <stop offset="1" stop-color="#0E1626" />
    </linearGradient>
    <radialGradient id="glow" cx="0.5" cy="1" r="0.6">
      <stop offset="0" stop-color="#5B9BFF" stop-opacity="0.35" />
      <stop offset="1" stop-color="#5B9BFF" stop-opacity="0" />
    </radialGradient>
    <filter id="bloom" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="2.2" result="b" />
      <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
    </filter>
  </defs>

  <rect width="640" height="256" fill="url(#sky)" />
  <ellipse cx="320" cy="256" rx="420" ry="90" fill="url(#glow)" />
  {stars.map(([x, y, r]) => <circle cx={x} cy={y} r={r} fill="#DCE7FF" opacity="0.8" />)}

  <rect y="254" width="640" height="166" fill="url(#ground)" />
  <g filter="url(#bloom)">
    {cityLights.map(([x, y]) => <circle cx={x} cy={y} r="1.3" fill="#F5C26B" opacity="0.75" />)}
  </g>

  <!-- Runway surface -->
  <polygon points={`${near.l},${near.y} ${near.r},${near.y} ${far.r},${far.y} ${far.l},${far.y}`} fill="url(#rwy)" />

  <g filter="url(#bloom)">
    <!-- Approach lighting: centreline barrettes + crossbar -->
    {[376, 394, 414].map((y, i) => <rect x={320 - (6 + i * 2)} y={y} width={12 + i * 4} height={2.6 + i * 0.6} rx="1" fill="#FFF4D6" />)}
    <rect x="250" y="394" width="140" height="3" rx="1.5" fill="#FFF4D6" opacity="0.95" />

    <!-- Threshold (green) and runway end (red) -->
    {threshold.map((x) => <circle cx={x} cy={near.y} r="2.4" fill="#4BFF9A" />)}
    {farEnd.map((x) => <circle cx={x} cy={far.y} r="0.9" fill="#FF5C5C" />)}

    <!-- Edge lights -->
    {edgeLights.map((p) => (
      <>
        <circle cx={p.l} cy={p.y} r={p.s} fill="#FFFFFF" />
        <circle cx={p.r} cy={p.y} r={p.s} fill="#FFFFFF" />
      </>
    ))}
    <!-- Centreline -->
    {centre.map((c) => <rect x={320 - c.w / 2} y={c.y - c.h} width={c.w} height={c.h} fill="#E9F0FF" opacity="0.85" />)}

    <!-- PAPI, left side: outer two white, inner two red = on the glide path -->
    {[['#FFFFFF', 168], ['#FFFFFF', 181], ['#FF4A4A', 194], ['#FF4A4A', 207]].map(([c, x]) => (
      <circle cx={x} cy="333" r="3" fill={c} />
    ))}
  </g>

  <!-- Glide path cue (brand magenta) -->
  <path d="M120 150 Q 250 255 318 338" fill="none" stroke="#E25CF0" stroke-width="1.6" stroke-dasharray="2 7" stroke-linecap="round" opacity="0.7" />
</svg>

<style>
  .hero-art { width: 100%; height: 100%; display: block; }
</style>
