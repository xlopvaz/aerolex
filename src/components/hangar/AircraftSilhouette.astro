---
/** Generic side-view silhouette of an aircraft family (configuration only, not to scale, no livery). */
import { silhouetteLabel, silhouetteSvg } from '../../lib/aircraft/silhouette.js';
import { t } from '../../i18n/index.js';

interface Props { config: { body: 'narrow' | 'wide'; engines: 2 | 4; decks: 1 | 2 }; lang: string; caption?: boolean }
const { config, lang, caption = false } = Astro.props;
const S = t(lang, 'hangar.silhouette');
const svg = silhouetteSvg(config, silhouetteLabel(config, S));
---
<figure class="sil-figure">
  <Fragment set:html={svg} />
  {caption && <figcaption>{S.caption}</figcaption>}
</figure>

<style is:global>
  .sil-figure { margin: 0; }
  .sil-figure figcaption { margin-top: var(--space-2); color: var(--text-muted); font-size: var(--text-xs); }
  .silhouette { display: block; width: 100%; height: auto; color: var(--text-muted); }
  .silhouette .sil-body { fill: var(--surface-2); stroke: currentColor; stroke-width: 1.4; }
  .silhouette .sil-tail, .silhouette .sil-wing { fill: color-mix(in srgb, var(--cyan) 22%, var(--surface-2)); stroke: currentColor; stroke-width: 1.2; stroke-linejoin: round; }
  .silhouette .sil-engine { fill: color-mix(in srgb, currentColor 35%, var(--surface)); stroke: currentColor; stroke-width: 1.2; }
  .silhouette .sil-cockpit { fill: var(--cyan); opacity: 0.85; }
  .silhouette .sil-windows { fill: var(--cyan); opacity: 0.7; }
  .silhouette .sil-ground { stroke: var(--border); stroke-width: 1; stroke-dasharray: 4 4; }
</style>
